[gd_scene format=3]

; The Wii Sensor Bar. Despite the name it senses nothing — it is two clusters of
; infrared LEDs on a stick, and the camera in the nose of the Wii Remote is what
; does the looking. That is why this object exists rather than the pointer being
; computed from the television: with IR passthrough the frontend hands Dolphin the
; camera's actual view of these two LEDs, so where they physically sit in the room
; IS the aim. Move the bar and the pointing changes, exactly as it would at home.
;
; 205 mm overall with the clusters 200 mm apart, which is what Dolphin assumes
; (CameraLogic::SENSOR_BAR_LED_SEPARATION = 0.2). The two Led markers are the
; measurement that matters — sensor_bar.gd reads their world positions, so the
; separation is whatever this scene says it is, not a constant repeated in code.
;
; -Z faces the player: the LEDs point back down the room at the remote, the same
; way the real bar faces out from the television it sits on.

[ext_resource type="Script" path="res://Scripts/Objects/peripherals/sensor_bar.gd" id="1_sbscript"]
[ext_resource type="Script" uid="uid://myg1jnlsxhnm" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="2_pickhigh"]
[ext_resource type="Script" uid="uid://b8uwrf51jd5xm" path="res://addons/godot-xr-tools/objects/grab_points/grab_point.gd" id="3_grabpoint"]

[sub_resource type="PhysicsMaterial" id="PhysMat_sb"]
friction = 0.9

; 205 x 22 x 20 mm. Long and light: it topples if you knock it, which is true to
; life and is why the real one ships with a stand.
; 238 x 23 x 9 mm, measured. Read as W x D x H on the real bar; here that is
; x = 238 wide, y = 9 HIGH, z = 23 deep, because the thing stands across a
; television and points at you.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.238, 0.009, 0.023)

; What a pointer can hit. The body box is on 3:Pickable, which the DESKTOP ray
; queries and the VR laser does not: XRToolsFunctionPointer masks 21 and 23 only,
; and XRToolsFunctionPickup._resolve_pickable then takes the collider or its
; direct parent. With nothing on 21 the bar was simply invisible to the laser and
; could not be picked up in VR at all, while working perfectly on the desktop.
;
; A shade bigger than the body on the two thin axes. The bar is 9 mm high, which
; is a hard thing to put a beam on across a room.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.242, 0.015, 0.027)

; TWO boxes, not one. The bar is silver for the 18 mm nearest the wire and black for
; the 5 mm facing the player — the black strip is the window the LEDs shine through,
; and it is the only part of this object anyone ever looks at head on.
[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(0.238, 0.009, 0.018)

[sub_resource type="BoxMesh" id="BoxMesh_face"]
size = Vector3(0.238, 0.009, 0.005)

[sub_resource type="StandardMaterial3D" id="Mat_silver"]
albedo_color = Color(0.6, 0.61, 0.63, 1)
metallic = 0.35
roughness = 0.35

[sub_resource type="StandardMaterial3D" id="Mat_shell"]
albedo_color = Color(0.09, 0.09, 0.1, 1)
roughness = 0.55

; The dark red window each cluster sits behind. Real IR is invisible, so the
; emission here is a courtesy to the player: without it there is nothing on the
; bar to tell you which face is the front, or that it is powered at all.
[sub_resource type="StandardMaterial3D" id="Mat_led"]
albedo_color = Color(0.18, 0.03, 0.03, 1)
emission_enabled = true
emission = Color(0.9, 0.12, 0.1, 1)
emission_energy_multiplier = 0.0

; Sized to the 9 mm the bar now is — the old 8 mm window was most of a 22 mm face and
; is nearly the whole of this one.
[sub_resource type="BoxMesh" id="BoxMesh_led"]
size = Vector3(0.016, 0.005, 0.0015)

; A shallow foot, so the bar stands on a television instead of rolling off it.
[node name="SensorBar" type="RigidBody3D" groups=["wii_sensor_bar"]]
collision_layer = 4
collision_mask = 196613
mass = 0.12
physics_material_override = SubResource("PhysMat_sb")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_sbscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_body")

; The silver block, sitting BACK: 18 mm of the 23 mm depth, so its centre is 2.5 mm
; behind the bar's own.
[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.0025)
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("Mat_silver")

; The black face the LEDs sit in, filling the front 5 mm.
[node name="Face" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.009)
mesh = SubResource("BoxMesh_face")
surface_material_override/0 = SubResource("Mat_shell")

[node name="LedLeft" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.1, 0, -0.0118)
mesh = SubResource("BoxMesh_led")
surface_material_override/0 = SubResource("Mat_led")

[node name="LedRight" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.1, 0, -0.0118)
mesh = SubResource("BoxMesh_led")
surface_material_override/0 = SubResource("Mat_led")

; Where the lead leaves the shell: the middle of the BACK face, trailing away
; from the room, which is where the real one goes and the only direction that
; does not cross in front of the lights.
;
; Turned 180 degrees about Y, so local -Z points BACKWARD in world terms.
;
; -Z is the axis that matters, and only that one: VerletRope::PlugExitDir feeds
; the anchor's basis through plug_exit_axis, which defaults to (0,0,-1), and that
; is the direction the cord actually leaves in. Getting the position right is not
; enough — the first fix here aimed the attach point's +Y forward (which is what
; the Nunchuk's spawn code reads) and left -Z pointing at the floor, so the plug
; started in the right place and the wire still dropped straight down.
[node name="CableAttachPoint" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0.0115)

[node name="PointerArea" type="StaticBody3D" parent="."]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PointerArea"]
shape = SubResource("BoxShape3D_pointer")

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("2_pickhigh")

; Marker3D, not Node3D: XRToolsGrabPoint extends Marker3D, and a script cannot
; be attached to a node less derived than the type it inherits. Godot reports
; that as an error rather than refusing to load, so on the desktop it scrolls
; past in a wall of log — on the Quest's debug build it stops the app dead.
;
; One plain grab point with no hand pose, copying the Nunchuk: `hand_pose` lives
; on XRToolsGrabPointHand, not on this script, and setting it here is the same
; class of mistake as the node type.
; Yawed 180 degrees, so the LED face points away from the holder rather than back
; at them. A grab driver poses the object at `hand * grab_point.transform.inverse()`,
; and a half-turn about Y is its own inverse, so this reads the same whichever way
; the basis is composed — the one rotation the .tscn row/column trap cannot bite on.
; The 8 mm rise is untouched by it: Y is the axis being turned about.
;
; Nothing else reads this. The bar is the one pickable here that never enters a
; snap zone — the console's SensorBarPort takes the LEAD's plug, not the bar — so
; XRToolsSnapZone.snap_pose_for, which would also have been turned by this, is
; never asked about it. led_positions() reports the two lights where they now are,
; which is the point: turn the bar round and the aim turns with it.
[node name="GrabPoint" type="Marker3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.008, 0)
visible = false
script = ExtResource("3_grabpoint")
