mesh = SubResource("BoxMesh_cart_recess")
surface_material_override/0 = SubResource("Mat_cart_recess")

; Sunk into the front face (z 0.114..0.126 against a face at 0.125) directly above
; controller port 1, which is where a PlayStation puts it. Hidden unless the
; console actually takes cards — RetroSystem shows it with the slot.
[node name="MemCardMouth" type="MeshInstance3D" parent="SystemBody" unique_id=1806706226]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.09, 0.038, 0.12)
visible = false
mesh = SubResource("BoxMesh_memcard_recess")
surface_material_override/0 = SubResource("Mat_cart_recess")

; Slot B, above controller port 2. Only consoles with two slots show it — a
; PlayStation has one and leaves this hidden, which is what card_slots says.
[node name="MemCardMouth2" type="MeshInstance3D" parent="SystemBody" unique_id=1806706227]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.03, 0.038, 0.12)
visible = false
mesh = SubResource("BoxMesh_memcard_recess")
surface_material_override/0 = SubResource("Mat_cart_recess")

