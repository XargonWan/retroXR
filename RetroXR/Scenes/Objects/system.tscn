script = ExtResource("5_pickhigh")

[node name="CartridgeSlot" parent="." unique_id=-294967295 instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.055, 0)
grab_distance = 0.07
snap_require = "cartridge"

; Above controller port 1, where a PlayStation puts it. A card goes in about half
; its length — ~33 mm of its 63.5 — leaving ~30 mm and the whole printed face
; standing out of the 0.125 front face. That is what the real machine looks like
; with a card in, and it is why the card is easy to take hold of. The proud 30 mm
; is what the 55 mm-wide card used to leave; the card grew along this axis, so the
; seat moved back to keep the tab the same rather than hanging it out further.
[node name="MemoryCardSlot" parent="." unique_id=-294967294 instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.09, 0.038, 0.1233)
grab_distance = 0.05
snap_require = "memory_card"

; Slot B, beside slot A above controller port 2 — the GameCube's two card slots
; sit side by side. A one-slot console hides and disables this one.
[node name="MemoryCardSlot2" parent="." unique_id=-294967293 instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.03, 0.038, 0.1233)
grab_distance = 0.05
snap_require = "memory_card"

[node name="ControllerCordAttach" type="Node3D" parent="." unique_id=946150953]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.125)

[node name="CableAttachPoint" type="Node3D" parent="." unique_id=1663596345]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.1, 0, -0.125)

; The console end of the A/V lead, and the same baked RCA plug the TV end wears
; (cable.tscn's PlugTip). It was a plain grey cylinder, which read as an unfinished
; stub next to a proper yellow connector at the other end.
;
; No transform: the mesh is authored connector-on-+Z, so under an attach point
; whose local -Z is the cable exit (the convention every configure_cable_attach
; follows) the connector already points into the jack and the cord trails out.
; No surface_material_override either — the materials are baked into the mesh.
[node name="PortVisual" type="MeshInstance3D" parent="CableAttachPoint" unique_id=1368038536]
mesh = ExtResource("7_rcaplug")

