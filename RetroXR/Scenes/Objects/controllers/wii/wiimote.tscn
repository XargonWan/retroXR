rings = 1

; HOME, 7.2 mm across. It used to be 9 — wider than MINUS and PLUS beside it,
; which the hardware does not do: on a real remote HOME is the same size as its
; neighbours or a whisker over, and what sets it apart is that it sits DOWN in a
; dish rather than that it is big.
[sub_resource type="CylinderMesh" id="Cyl_home"]
top_radius = 0.0036
bottom_radius = 0.0036
height = 0.0022
radial_segments = 16
rings = 1

[sub_resource type="CylinderMesh" id="Cyl_num"]
top_radius = 0.0045
bottom_radius = 0.0045
height = 0.0025
radial_segments = 12
rings = 1

; Poke volumes for the face buttons, a touch wider than the caps so a fingertip
; that lands on the edge of one still counts as on it.
[sub_resource type="CylinderShape3D" id="CylShape_a"]
radius = 0.007
height = 0.005

[sub_resource type="CylinderShape3D" id="CylShape_small"]
radius = 0.005
height = 0.004

[sub_resource type="CylinderShape3D" id="CylShape_home"]
radius = 0.006
height = 0.004

[sub_resource type="CylinderShape3D" id="CylShape_num"]
radius = 0.006
height = 0.004

; Poke volume for POWER. Same idea as the face caps' — a touch wider than the
; cap so a fingertip landing on its edge still counts as on it.
[sub_resource type="CylinderShape3D" id="CylShape_power"]
radius = 0.005
height = 0.004

; The dished lip POWER and HOME sit down inside. Both are recessed on the real
; shell, and neither can be bored here — the body is one closed loft, so nothing
; below its top face can be seen at all.
;
; So the recess is built the other way up: a raised LIP whose crown clears the cap
; it surrounds, which reads as a dish because the cap is the lower of the two. It
; has to be a RING and not a disc — a solid disc of larger radius simply swallows
; the cap, which is what made HOME a featureless grey plate. The tube is
; (outer - inner) / 2 = 0.8 mm, so each lip stands 0.8 mm off its centre line and
; 0.4 mm above the cap in its mouth.
[sub_resource type="StandardMaterial3D" id="Mat_well"]
albedo_color = Color(0.74, 0.745, 0.76, 1)
metallic_specular = 0.4
roughness = 0.55

[sub_resource type="TorusMesh" id="Torus_power_lip"]
inner_radius = 0.0028
outer_radius = 0.0044
rings = 20
ring_segments = 6

[sub_resource type="TorusMesh" id="Torus_home_lip"]
inner_radius = 0.004
outer_radius = 0.0056
rings = 20
ring_segments = 6

; One speaker hole / LED index pip. Every dot on the face is this mesh under a
; MultiMesh: 36 of them, one draw call. Separate MeshInstance3Ds would be 36
; draws per remote on a CPU-bound headset, for detail 1 mm across.
[sub_resource type="CylinderMesh" id="Cyl_hole"]
