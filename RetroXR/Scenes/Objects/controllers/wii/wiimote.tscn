; Down 1.1 mm, which puts its crown 0.4 mm under the lip's — and still 0.9 mm
; clear of the face when pressed, so the travel never sinks into the shell (where
; the box's own top surface would hide it outright).
[node name="ButtonMesh" type="MeshInstance3D" parent="PowerButton"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0011, 0)
mesh = SubResource("Cyl_power")
surface_material_override/0 = SubResource("Mat_power")

