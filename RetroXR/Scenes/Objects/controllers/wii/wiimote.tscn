[sub_resource type="PhysicsMaterial" id="PhysMat_wm"]
friction = 0.8

; 36 x 30 x 148 mm — the real remote's shell, long axis on Z with -Z forward
; (the IR window end). Every child position below is measured off that.
;
; The physics proxy stays a plain box even though the shell is now a lofted
; solid with filleted edges and rolled ends. A box is the right proxy for a
; bar-shaped prop, and holding it fixed across the reshape kept grab, throw,
; snap-zone and save/restore behaviour bit-identical while the visual moved.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.036, 0.03, 0.148)

; The console's lacquer, to the number — Mat_white in wii_primitive.tscn. Same moulded
; white plastic on the real hardware, and the gloss is what carries the shape: these
; rooms light with a flat ambient and no radiance map, so a matte white slab renders as
; one even field with nothing to say it is a solid object.
[sub_resource type="StandardMaterial3D" id="Mat_shell"]
albedo_color = Color(0.93, 0.93, 0.915, 1)
metallic_specular = 0.6
roughness = 0.15
clearcoat_enabled = true
clearcoat = 0.65
clearcoat_roughness = 0.04

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.1, 0.1, 0.11, 1)

; The moulding parting line down both flanks. A ribbon standing 0.15 mm off the
; shell rather than a groove cut into it — the shell is a closed loft and a real
; groove would mean splitting every ring. Barely darker than the lacquer: this
; is a shut line catching light, not an inked stripe.
;
; CULL_DISABLED because a ribbon is a SHEET. It encloses no volume, so nothing in
; the generator can decide which way it should face, and the material is where
; that stops mattering.
[sub_resource type="StandardMaterial3D" id="Mat_seam"]
cull_mode = 2
albedo_color = Color(0.86, 0.86, 0.85, 1)
metallic_specular = 0.5
roughness = 0.35

[sub_resource type="StandardMaterial3D" id="Mat_grey"]
albedo_color = Color(0.72, 0.72, 0.74, 1)

; The 1/2/-/+ caps and the trigger, a touch darker than the shell so they read
; as separate parts under the room's light rather than as printed circles.
[sub_resource type="StandardMaterial3D" id="Mat_cap"]
albedo_color = Color(0.62, 0.63, 0.66, 1)

[sub_resource type="BoxMesh" id="BoxMesh_ir"]
size = Vector3(0.022, 0.01, 0.002)

; D-pad: one cross built from two bars rather than four separate keys, which is
; what the real one is — a single rocker.
[sub_resource type="BoxMesh" id="BoxMesh_dpad_h"]
size = Vector3(0.019, 0.003, 0.0065)

[sub_resource type="BoxMesh" id="BoxMesh_dpad_v"]
size = Vector3(0.0065, 0.003, 0.019)

